# ---------------------------------------------------------------------------
# Пример конфигурации. Скопируйте в .env и заполните: cp .env.example .env
# Файл .env содержит секреты и НЕ должен попадать в репозиторий.
# ---------------------------------------------------------------------------

# Адрес и порт, на которых docker публикует веб-интерфейс на хосте.
# По умолчанию — только локально (127.0.0.1). Для доступа из внутренней сети
# используйте reverse proxy с HTTPS (см. README), а не 0.0.0.0.
BIND_ADDRESS=127.0.0.1
BIND_PORT=8000

# Доверять заголовкам X-Forwarded-For/-Proto от reverse proxy.
# Если порт опубликован только на 127.0.0.1 (по умолчанию) и перед приложением
# стоит nginx на этой же ВМ, укажите *. Иначе — адрес прокси.
FORWARDED_ALLOW_IPS=127.0.0.1

# Секрет для подписи токенов сессий (обязательно, длинная случайная строка):
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Первый администратор создаётся при первом запуске, если в базе нет пользователей.
# После первого входа удалите ADMIN_PASSWORD из .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Cookie только по HTTPS. Оставьте true при работе через reverse proxy с HTTPS.
# false — только для локальной проверки по http://127.0.0.1.
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
TIMEZONE=Europe/Moscow

# Ограничение попыток входа
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# Дополнительный ограничитель области: CIDR и домены через запятую.
# Если задан, цели вне этого списка добавить невозможно.
# ALLOWED_SCOPE=203.0.113.0/24,198.51.100.0/28,example.com
ALLOWED_SCOPE=
MAX_CIDR_HOSTS=4096

# --- nmap ---
NMAP_PRIVILEGED=true
# Скорость по умолчанию: 0..5 (-T0 … -T5)
NMAP_TIMING=3
# Сколько сканирований может выполняться одновременно
MAX_PARALLEL_SCANS=2
SCAN_TIMEOUT_MINUTES=360
HOST_TIMEOUT_MINUTES=60
SCRIPT_TIMEOUT_MINUTES=5

# --- Проверки доменов и веба ---
DNS_TIMEOUT=5
HTTP_TIMEOUT=10
CRTSH_ENABLED=true
SUBDOMAIN_BRUTEFORCE=true
CHECK_SUBDOMAINS_WEB=true
MAX_SUBDOMAINS_WEB=50

# --- Уведомления (включаются/выключаются в интерфейсе: «Уведомления») ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Получатели через запятую
SMTP_TO=
SMTP_STARTTLS=true
SMTP_SSL=false

# Внешний адрес интерфейса для ссылок в уведомлениях, например https://perimeter.corp.local
PUBLIC_URL=
