# ---------------------------------------------------------------------------
# Пример конфигурации. Скопируйте в .env и заполните: cp .env.example .env
# Файл .env содержит секреты и НЕ должен попадать в репозиторий.
# ---------------------------------------------------------------------------

# Адрес и порт, на которых docker публикует веб-интерфейс на хосте.
# По умолчанию — только локально (127.0.0.1). Для доступа из внутренней сети
# используйте reverse proxy с HTTPS (см. README), а не 0.0.0.0.
BIND_ADDRESS=127.0.0.1
BIND_PORT=8000

# Доверять заголовкам X-Forwarded-For/-Proto от reverse proxy.
# Если порт опубликован только на 127.0.0.1 (по умолчанию) и перед приложением
# стоит nginx на этой же ВМ, укажите *. Иначе — адрес прокси.
FORWARDED_ALLOW_IPS=127.0.0.1

# Секрет для подписи токенов сессий (обязательно, длинная случайная строка):
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Первый администратор создаётся при первом запуске, если в базе нет пользователей.
# После первого входа удалите ADMIN_PASSWORD из .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Cookie только по HTTPS. Оставьте true при работе через reverse proxy с HTTPS.
# false — только для локальной проверки по http://127.0.0.1.
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
TIMEZONE=Europe/Moscow

# Ограничение попыток входа
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# Дополнительный ограничитель области: CIDR и домены через запятую.
# Если задан, цели вне этого списка добавить невозможно.
# ALLOWED_SCOPE=203.0.113.0/24,198.51.100.0/28,example.com
ALLOWED_SCOPE=
MAX_CIDR_HOSTS=4096

# --- nmap ---
NMAP_PRIVILEGED=true
# Скорость по умолчанию: 0..5 (-T0 … -T5). T4 — рекомендуемая для надёжных каналов.
NMAP_TIMING=4
# Двухфазное сканирование для «Полного»/«Агрессивного»: сначала быстрый поиск открытых
# TCP-портов (все 65535), затем глубокий анализ (-sV, -O, скрипты, UDP) только найденного.
NMAP_TWO_PHASE=true
# Минимальная скорость, пакетов/с (0 — не задавать). Чем выше, тем быстрее, но при слабом
# канале или строгом IPS возможны пропуски портов. 1000–5000 — разумный диапазон.
NMAP_MIN_RATE=1000
NMAP_MAX_RETRIES=2
# Сколько хостов сканировать одновременно в одной группе
NMAP_MIN_HOSTGROUP=64
# -Pn: не полагаться на ping (хосты периметра часто его блокируют). false — быстрее, но менее полно.
NMAP_SKIP_HOST_DISCOVERY=true
# UDP по всем адресам подсетей, а не только по хостам с открытыми TCP-портами (медленно)
NMAP_UDP_ALL_HOSTS=false
# Сколько сканирований может выполняться одновременно
MAX_PARALLEL_SCANS=2
SCAN_TIMEOUT_MINUTES=360
HOST_TIMEOUT_MINUTES=60
SCRIPT_TIMEOUT_MINUTES=5

# --- Активные проверки (воздействуют на цель; только ручной запуск админом) ---
# Полностью отключить раздел активных проверок:
ACTIVE_TESTS_ENABLED=true
# Подбор учётных данных (Hydra)
HYDRA_ENABLED=true
HYDRA_DEFAULT_TASKS=4
HYDRA_MAX_TASKS=16
# Жёсткий лимит числа комбинаций за один запуск — защита от блокировки учёток
HYDRA_MAX_ATTEMPTS=2000
HYDRA_TIMEOUT_MINUTES=30
# Metasploit (эксплуатация; поднимается отдельным контейнером, профиль docker compose --profile msf)
MSF_ENABLED=false
MSF_RPC_HOST=127.0.0.1
MSF_RPC_PORT=55553
MSF_RPC_SSL=true
# Пароль RPC Metasploit — задаётся при включении msf (см. README)
MSF_RPC_PASSWORD=
MSF_TIMEOUT_MINUTES=20

# --- Проверки доменов и веба ---
DNS_TIMEOUT=5
HTTP_TIMEOUT=10
CRTSH_ENABLED=true
SUBDOMAIN_BRUTEFORCE=true
CHECK_SUBDOMAINS_WEB=true
MAX_SUBDOMAINS_WEB=50

# --- Уведомления (включаются/выключаются в интерфейсе: «Уведомления») ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Получатели через запятую
SMTP_TO=
SMTP_STARTTLS=true
SMTP_SSL=false

# Внешний адрес интерфейса для ссылок в уведомлениях, например https://perimeter.corp.local
PUBLIC_URL=
